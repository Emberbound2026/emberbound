# Copy this to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Never commit .env.local — it's in .gitignore.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed locally to run supabase/seed.js — this is the service role
# key, which bypasses Row Level Security. Never expose it to the client
# or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=
